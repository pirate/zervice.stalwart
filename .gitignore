# This repository is allowlisted: only reviewed, reproducible configuration and
# source files below may be committed. Everything else is runtime or local data.
*

!/.gitignore
!/.env.example
!/README.md
!/docker-compose.yml
!/send-mail-tester.py

!/rules-watcher/
!/rules-watcher/README.md
!/rules-watcher/admin.js
!/rules-watcher/backfill.js
!/rules-watcher/watcher.js
!/rules-watcher/watcher.test.js

!/data/
!/data/maintenance/
!/data/maintenance/renew-certificate.sh
!/data/nginx/
!/data/nginx/templates/
!/data/nginx/templates/nginx.conf.template
!/data/stalwart/
!/data/stalwart/config/
!/data/stalwart/config/config.json

# Defense in depth if the allowlist is expanded later.
.env
.env.*
!.env.example
secrets/
backups/
tools/
data/nginx/config/
**/node_modules/
**/*password*
**/*secret*
**/*token*
**/*.pem
**/*.key
**/*.crt
**/*.sqlite*
**/*.db
**/*.enc
**/*.log
**/*.jsonl
**/.DS_Store
