# Copy this file to .env and replace every example value before starting the
# stack. The real .env file is intentionally ignored.
COMPOSE_PROJECT_NAME=stalwart-mail
MAIL_BIND_IP=203.0.113.10
STALWART_PUBLIC_URL=https://mail.example.com
MAIL_SERVER_NAMES=mail.example.com
WEBMAIL_SERVER_NAME=webmail.example.com
CERTBOT_CERT_NAME=mail-example
SMTP_HOST=mail.example.com
SMTP_PORT=587

# Rules watcher routing. JSON values must remain on one line.
RULES_BOT_USERNAME=rules-bot@example.com
RULES_TARGETS=owner@example.com
RULES_ROUTES={"owner@example.com":["example.com"]}
RULES_COPY_FORWARDS={}

# Bulwark runtime settings.
NODE_ENV=production
APP_NAME=Webmail
APP_SHORT_NAME=Webmail
JMAP_SERVER_URL=https://mail.example.com
ALLOW_CUSTOM_JMAP_ENDPOINT=false
STALWART_FEATURES=true
OAUTH_ENABLED=false
OAUTH_ONLY=false
SESSION_SECRET=
SETTINGS_SYNC_ENABLED=true
SETTINGS_DATA_DIR=/app/data/settings
ADMIN_PASSWORD=
ADMIN_CONFIG_DIR=/app/data/admin
ADMIN_STATE_DIR=/app/data/admin-state
BULWARK_TELEMETRY=off
LOG_LEVEL=info
TRUSTED_PROXY_DEPTH=1

# Optional Stalwart recovery-mode overrides referenced by Docker Compose.
STALWART_RECOVERY_MODE=false
STALWART_RECOVERY_ADMIN=
